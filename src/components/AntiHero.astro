---
import { Image } from 'astro:assets';
import antiHeroImg from '../assets/anti-hero.jpg';

interface Props {
  title?: string;
  image?: ImageMetadata | string;
}

const { title = "Anti-Hero", image = antiHeroImg } = Astro.props;
---

<div class="real-talk-box">
  <div class="real-talk-badge">
    <span class="real-talk-icon" aria-hidden="true">
      {typeof image === 'string' ? (
        <img
          src={image}
          alt=""
          width="24"
          height="24"
          class="anti-hero-icon"
        />
      ) : (
        <Image
          src={image}
          alt=""
          width={24}
          height={24}
          class="anti-hero-icon"
        />
      )}
    </span>
    <span class="real-talk-label">{title}</span>
  </div>
  <div class="real-talk-body">
    <slot />
  </div>
</div>

<style>
  .anti-hero-icon {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 4px;
    object-fit: cover;
    display: inline-block;
    vertical-align: middle;
  }
</style>
